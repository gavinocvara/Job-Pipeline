# Copy to .env and fill in real values. .env is gitignored — it will not be committed.
# Never put real keys in THIS file; it is the committed template.

# --- Required: model access -----------------------------------------------
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Job search (free) ----------------------------------------------------
# developer.adzuna.com -> register -> dashboard
ADZUNA_APP_ID=REPLACE-ME
ADZUNA_APP_KEY=REPLACE-ME

# --- Email notifications (optional) ---------------------------------------
# Gmail: use an App Password (myaccount.google.com/apppasswords), NOT your password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=REPLACE-ME
NOTIFY_EMAIL=you@gmail.com

# --- Pipeline settings ----------------------------------------------------
TARGET_LOCATION=Austin, TX
MAX_REVIEW_ROUNDS=3
MIN_KEYWORD_MATCH=0.70

# --- Self-improvement -----------------------------------------------------
# Prompt refinements apply automatically. Code patches ALWAYS wait for you.
AUTO_IMPROVE=true

# --- GitHub push access (lets agents ship their own fixes) ----------------
# Fine-grained token: github.com/settings/tokens?type=beta
# Scope it to ONLY this repo, Contents: Read and write. Nothing else.
GITHUB_TOKEN=github_pat_REPLACE-ME
GITHUB_REPO=yourname/application-desk

# --- Auto-deploy behavior -------------------------------------------------
# false = agents push a branch, you merge. true = low-risk approved patches
# merge to main and deploy themselves. Start with false.
AUTO_MERGE=false
AUTO_DEPLOY=false
MAX_DEPLOYS_PER_DAY=6

# Your live Render URL. Required for auto-rollback — without it a bad deploy
# stays broken instead of self-healing.
HEALTH_CHECK_URL=https://your-app.onrender.com
# Optional: Render dashboard -> Settings -> Deploy Hook
RENDER_DEPLOY_HOOK=
